        "#\n",
        "# Phase 1: Feature Engineering\n",
        "# Track A : 11 handcrafted biological features\n",
        "# Track B : 256 standard 4-mer features (baseline)\n",
        "# Track C : 136 RC-symmetric 4-mer features\n",
        "# Track D : Track A + Track C combined\n",
        "\n",
        "\n",
        "# ── Biological feature functions\n",
        "def gc_content(seq):   return (seq.count('g') + seq.count('c')) / len(seq)\n",
        "def at_content(seq):   return (seq.count('a') + seq.count('t')) / len(seq)\n",
        "def gc_skew(seq):      return (seq.count('g') - seq.count('c')) / len(seq)\n",
        "def at_skew(seq):      return (seq.count('a') - seq.count('t')) / len(seq)\n",
        "def purine_ratio(seq): return (seq.count('a') + seq.count('g')) / len(seq)\n",
        "def cpg_score(seq):\n",
        "    c = seq.count('c'); g = seq.count('g'); cg = seq.count('cg')\n",
        "    return (cg / len(seq)) * (len(seq) / (c * g + 1))\n",
        "def motif_score(seq):  return sum(seq.count(m) for m in ['tata','caat','gc'])\n",
        "def kmer_diversity(seq, k=2):\n",
        "    return len(set(seq[i:i+k] for i in range(len(seq)-k+1)))\n",
        "\n",
        "def compute_track_A(seq):\n",
        "    seq = seq.lower()\n",
        "    tata_p = seq.find('tata') if 'tata' in seq else -1\n",
        "    return [\n",
        "        gc_content(seq), at_content(seq),\n",
        "        gc_skew(seq),    at_skew(seq),\n",
        "        purine_ratio(seq), cpg_score(seq),\n",
        "        motif_score(seq),  seq.count('tata'),\n",
        "        tata_p,\n",
        "        kmer_diversity(seq, k=2),\n",
        "        kmer_diversity(seq, k=3)\n",
        "    ]\n",
        "\n",
        "TRACK_A_NAMES = [\n",
        "    'gc','at','gc_skew','at_skew','purine',\n",
        "    'cpg','motif','tata_count','tata_pos',\n",
        "    'kmer2_div','kmer3_div'\n",
        "]\n",
        "\n",
        "# ── Build all feature matrices\n",
        "print(\"Building feature matrices...\")\n",
        "\n",
        "print(\"  Track A: biological features...\", end=' ')\n",
        "X_A = np.array([compute_track_A(s) for s in df['sequence']])\n",
        "print(f\"done — shape {X_A.shape}\")\n",
