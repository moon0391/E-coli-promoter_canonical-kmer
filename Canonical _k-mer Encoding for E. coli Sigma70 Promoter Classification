        "print(f\"  Sequence length : {SEQ_LEN} bp\")\n",
        "print(f\"  Columns         : {df.columns.tolist()}\")\n",
        "\n",
        "\n",
        "\n",
        "# CORE UTILITY FUNCTIONS — used throughout all phases\n",
        "\n",
        "def reverse_complement(seq):\n",
        "    \"\"\"Return the reverse complement of a DNA sequence.\"\"\"\n",
        "    comp = {'a':'t', 't':'a', 'g':'c', 'c':'g'}\n",
        "    return ''.join(comp.get(b, b) for b in reversed(seq.lower()))\n",
        "\n",
        "# ── Verify RC function ─────────────────────────────────────────\n",
        "test_seq = 'atgcta'\n",
        "test_rc  = reverse_complement(test_seq)\n",
        "assert test_rc == 'tagcat', f\"RC function wrong: got {test_rc}\"\n",
        "print(f\"\\n  RC test passed: {test_seq} → {test_rc}\")\n",
        "\n",
        "# ── Key insight: what is the RC of a 4-mer? ───────────────────\n",
        "# This is the mathematical foundation of our unique contribution.\n",
        "# For every 4-mer k, its reverse complement rc(k) is also a 4-mer.\n",
        "# Some 4-mers are palindromes: k == rc(k)  e.g. 'atat', 'gcgc'\n",
        "# Our novel idea: merge each (k, rc(k)) pair into ONE feature.\n",
        "\n",
        "all_4mers = [''.join(p) for p in iproduct('acgt', repeat=4)]\n",
        "\n",
        "# Build RC pairs\n",
        "seen = set()\n",
        "rc_pairs   = []   # list of (kmer, rc_kmer) tuples\n",
        "palindromes = []  # kmers where kmer == rc(kmer)\n",
        "\n",
        "for km in all_4mers:\n",
        "    rc_km = reverse_complement(km)\n",
        "    if km == rc_km:\n",
        "        if km not in seen:\n",
        "            palindromes.append(km)\n",
        "            seen.add(km)\n",
        "    else:\n",
        "        pair = tuple(sorted([km, rc_km]))\n",
        "        if pair not in seen:\n",
        "            rc_pairs.append(pair)\n",
        "            seen.add(pair)\n",
        "\n",
        "N_SYMMETRIC_FEATURES = len(rc_pairs) + len(palindromes)\n",
        "\n",
        "print(f\"\\n  4-mer RC symmetry analysis:\")\n",
        "print(f\"    Total 4-mers          : {len(all_4mers)}\")\n",
        "print(f\"    Palindromic 4-mers    : {len(palindromes)}\")\n",
        "print(f\"    RC-paired 4-mers      : {len(rc_pairs)} pairs\")\n",
        "print(f\"    RC-symmetric features : {N_SYMMETRIC_FEATURES}  ← novel feature count\")\n",
        "print(f\"    (vs 256 standard 4-mer features)\")\n",
        "print(f\"\\n  Example palindromes : {palindromes[:5]}\")\n",
        "print(f\"  Example RC pairs    : {rc_pairs[:5]}\")\n",
        "\n",
        "\n",
        "# ─RC-Symmetric k-mer feature builder\n",
        "# This is our unique work:\n",
        "# Instead of 256 asymmetric 4-mer frequencies,\n",
        "# we compute 136 RC-symmetric features by merging\n",
        "# each (kmer, rc_kmer) pair into a single combined frequency.\n",
        "\n",
        "def build_rc_symmetric_kmers(seq, k=4):\n",
        "\n",
        "    #Compute RC-symmetric k-mer features.\n",
        "    #For each RC pair (km, rc_km): feature = freq(km) + freq(rc_km)\n",
        "    #For palindromes: feature = freq(km)  [already symmetric]\n",
        "\n",
        "    #Returns a vector of length N_SYMMETRIC_FEATURES (136 for k=4).\n",
        "    #This vector is BY CONSTRUCTION identical for seq and rc(seq).\n",
        "\n",
        "    seq = seq.lower()\n",
        "    total = len(seq) - k + 1\n",
        "    counts = Counter(seq[i:i+k] for i in range(total))\n",
        "\n",
        "    features = []\n",
        "    # RC pairs: sum frequencies of both members\n",
        "    for (km, rc_km) in rc_pairs:\n",
        "        combined = (counts.get(km, 0) + counts.get(rc_km, 0)) / total\n",
        "        features.append(combined)\n",
        "    # Palindromes: just their own frequency\n",
        "    for km in palindromes:\n",
        "        features.append(counts.get(km, 0) / total)\n",
        "\n",
        "    return features\n",
        "\n",
        "# ── Verify RC symmetry property\n",
        "# CHECK: feat(seq) must equal feat(rc(seq)) for any seq\n",
        "test_seq2 = df['sequence'].iloc[0]\n",
        "feat_orig = build_rc_symmetric_kmers(test_seq2)\n",
        "feat_rc   = build_rc_symmetric_kmers(reverse_complement(test_seq2))\n",
        "max_diff  = max(abs(a - b) for a, b in zip(feat_orig, feat_rc))\n",
        "print(f\"\\n  RC-symmetric feature verification:\")\n",
        "print(f\"    Max difference between feat(seq) and feat(rc(seq)): {max_diff:.2e}\")\n",
        "assert max_diff < 1e-10, \"RC symmetry BROKEN — check build_rc_symmetric_kmers!\"\n",
        "print(f\"    Perfect RC symmetry confirmed (diff < 1e-10)\")\n",
        "print(f\"    eature length: {len(feat_orig)} (expected {N_SYMMETRIC_FEATURES})\")\n",
        "\n",
        "# ── Standard 4-mer feature builder (for baseline comparison) ──\n",
        "def build_standard_kmers(seq, k=4):\n",
        "    \"\"\"Standard 256-feature 4-mer frequency vector.\"\"\"\n",
        "    seq = seq.lower()\n",
        "    all_kmers = [''.join(p) for p in iproduct('acgt', repeat=k)]\n",
        "    total = len(seq) - k + 1\n",
        "    counts = Counter(seq[i:i+k] for i in range(total))\n",
        "    return [counts.get(km, 0) / total for km in all_kmers]\n",
        "\n",
        "print(f\"\\n  Standard 4-mer feature length: {len(build_standard_kmers(test_seq2))}\")\n",
        "\n",
        "print(\"\\n\" + \"═\" * 55)\n",
        "print(\"  PHASE 0 COMPLETE — all utilities ready\")\n",
        "print(\"  Key numbers:\")\n",
        "print(f\"    Dataset: {len(df)} sequences × {SEQ_LEN} bp\")\n",
        "print(f\"    Novel RC-symmetric features: {N_SYMMETRIC_FEATURES}\")\n",
        "print(f\"    Standard 4-mer features: 256\")\n",
        "print(\"═\" * 55)"
