        "# Phase 2b: McNemar's Test — SVM/Track B vs RF/Track C\n",
        "#  Is the accuracy difference statistically significant?\n",
        "#\n",
        "\n",
        "from statsmodels.stats.contingency_tables import mcnemar\n",
        "import numpy as np\n",
        "\n",
        "# RF/Track C is the overall best model (highest Acc, F1, MCC, AUROC, 100% RC).\n",
        "# SVM/Track B is the best *standard* k-mer model (previous best before this study).\n",
        "# This is the most meaningful comparison for the paper's core claim.\n",
        "\n",
        "model_B_name = 'SVM / Track B'\n",
        "model_C_name = 'RF / Track C'\n",
        "\n",
        "preds_B = results[model_B_name]['y_pred']\n",
        "preds_C = results[model_C_name]['y_pred']\n",
        "\n",
        "correct_B = (preds_B == y_te)\n",
        "correct_C = (preds_C == y_te)\n",
        "\n",
        "# Contingency table cells\n",
        "b_wrong_c_right = np.sum((~correct_B) & correct_C)\n",
        "b_right_c_wrong = np.sum(correct_B & (~correct_C))\n",
        "both_right       = np.sum(correct_B & correct_C)\n",
        "both_wrong        = np.sum((~correct_B) & (~correct_C))\n",
        "\n",
        "table = [[both_right, b_right_c_wrong],\n",
        "         [b_wrong_c_right, both_wrong]]\n",
        "\n",
        "result = mcnemar(table, exact=True)\n",
        "\n",
        "print(\"═\"*62)\n",
        "print(f\"  McNemar's Exact Test — {model_B_name} vs {model_C_name}\")\n",
        "print(\"═\"*62)\n",
        "print(f\"  Both correct              : {both_right}\")\n",
        "print(f\"  Both wrong                : {both_wrong}\")\n",
        "print(f\"  B correct, C wrong        : {b_right_c_wrong}\")\n",
        "print(f\"  B wrong, C correct        : {b_wrong_c_right}\")\n",
        "print(f\"\\n  Statistic = {result.statistic}\")\n",
        "print(f\"  p-value   = {result.pvalue:.4f}\")\n",
        "\n",
        "alpha = 0.05\n",
        "if result.pvalue < alpha:\n",
        "    print(f\"\\n  ✓ Statistically significant at α=0.05 — the accuracy\")\n",
        "    print(f\"    difference between the two models is unlikely due to chance.\")\n",
